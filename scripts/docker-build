#!/usr/bin/env bash
set -euo pipefail

MEMORY="${MEMORY:-8gb}"
GIT_PROJECT="${PWD##*/}"
IMAGE="${IMAGE:-graalvm-dev}"
TAG="${TAG:-latest}"
M2_DIR="${M2_DIR-${HOME}/.m2}"

mkdir -p "${PWD}/.gradle-docker/daemon" \
  "${PWD}/.gradle-docker/.tmp" \
  "${PWD}/.gradle-docker/notifications" \
  "${PWD}/.gradle-project-docker"

if [ -n "${M2_DIR}" ]; then
  mkdir -p "${M2_DIR}/repository"
fi

resolve_global_gitignore() {
  local excludes=""
  if command -v git >/dev/null 2>&1; then
    excludes="$(git config --path --get core.excludesFile 2>/dev/null || true)"
  fi
  if [ -z "${excludes}" ] && [ -f "${XDG_CONFIG_HOME:-${HOME}/.config}/git/ignore" ]; then
    excludes="${XDG_CONFIG_HOME:-${HOME}/.config}/git/ignore"
  fi
  if [ -z "${excludes}" ] && [ -f "${HOME}/.gitignore_global" ]; then
    excludes="${HOME}/.gitignore_global"
  fi
  if [ -n "${excludes}" ] && [ -f "${excludes}" ]; then
    printf '%s\n' "${excludes}"
  fi
}

run_docker() {
  local it_flags="$1"
  shift
  local gitignore_args=()
  local global_gitignore
  global_gitignore="$(resolve_global_gitignore)"
  if [ -n "${global_gitignore}" ]; then
    gitignore_args=(-e XDG_CONFIG_HOME="/root/.config" -v "${global_gitignore}:/root/.config/git/ignore:ro")
  fi

  local m2_args=()
  if [ -n "${M2_DIR}" ]; then
    m2_args=(-v "${M2_DIR}:/root/.m2" -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)")
  fi

  docker run --name "${GIT_PROJECT}-build-$(date +%s)-$$" \
    -e JAVA_TOOL_OPTIONS="--sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED" \
    -e GRADLE_USER_HOME="/git/${GIT_PROJECT}/.gradle-docker" \
    -e GRADLE_OPTS="-Dorg.gradle.projectcachedir=/git/${GIT_PROJECT}/.gradle-project-docker -Dorg.gradle.welcome=never -XX:TieredStopAtLevel=1 -XX:+UseParallelGC" \
    ${gitignore_args[@]+"${gitignore_args[@]}"} \
    ${m2_args[@]+"${m2_args[@]}"} \
    ${it_flags} \
    --rm \
    -v "${PWD}:/git/${GIT_PROJECT}/" \
    --tmpfs "/tmp:rw,exec,nosuid,size=512m" \
    --tmpfs "/git/${GIT_PROJECT}/.gradle-docker/daemon:rw,nosuid,size=128m" \
    --tmpfs "/git/${GIT_PROJECT}/.gradle-docker/.tmp:rw,nosuid,size=128m" \
    --tmpfs "/git/${GIT_PROJECT}/.gradle-docker/notifications:rw,nosuid,size=16m" \
    -w "/git/${GIT_PROJECT}" \
    --memory="${MEMORY}" \
    "${IMAGE}:${TAG}" \
    "$@"
}

if [ "$#" -eq 0 ]; then
  run_docker "-it" bash
else
  quoted=$(printf '%q ' "$@")
  run_docker "-i" bash -lc "${quoted% }"
fi
